# ============ 必填 ============

# 服务器对外可访问的 IP 或域名(不能填 localhost / 127.0.0.1, 前端需要用它拼接后端地址)
HOST_IP=127.0.0.1

# 大模型服务: 任意 OpenAI 兼容接口均可(示例为硅基流动)
OPENAI_API_KEY=your_api_key_here
MODEL_API_BASE_URL=https://api.siliconflow.cn/v1

# 模型名
BASE_LLM=Qwen/Qwen3-30B-A3B-Instruct-2507
BASE_VLM=Qwen/Qwen2.5-VL-72B-Instruct
IMAGE_MODEL=Kwai-Kolors/Kolors
EDIT_IMAGE_MODEL=Qwen/Qwen-Image-Edit

# ============ 可选 ============

# 联网搜索(留空则不挂载 Tavily 搜索工具)
TAVILY_SEARCH_KEY=

# LangChain 追踪调试
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# 子代理开关(开启后主 Agent 会把 Excel / PPT 需求路由给子代理)
USE_PPT=false
USE_EXCEL=false
PPT_MCP_URL=http://localhost:4810/mcp

# MinIO 对象存储(用于生成产物下载链接)
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 服务端口
AGENT_SERVER_PORT=8000
AGENT_UI_PORT=3000
